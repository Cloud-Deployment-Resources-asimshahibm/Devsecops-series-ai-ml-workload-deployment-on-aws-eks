  {
   "id": 14,
   "type": "timeseries",
   "title": "CPU usage vs request (per pod)",
   "description": "HPA target is 65% of request",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container=\"api\"}[5m])) / sum by (pod) (kube_pod_container_resource_requests{namespace=\"$namespace\",container=\"api\",resource=\"cpu\"})",
     "legendFormat": "{{pod}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
