{
 "uid": "ml-performance",
 "title": "ML Platform \u2014 Performance",
 "description": "RED + USE for inference, GPU, Ray, pipelines, JupyterHub and cluster autoscaling.",
 "tags": [
  "ml",
  "performance"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "current": {
     "text": "Prometheus",
     "value": "prometheus"
    },
    "hide": 0
   },
   {
    "name": "namespace",
    "type": "custom",
    "query": "ml-serving",
    "current": {
     "text": "ml-serving",
     "value": "ml-serving"
    },
    "hide": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Inference \u2014 RED (rate, errors, duration)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Throughput",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(mlserve_http_requests_total{namespace=\"$namespace\",route=\"/v1/predict\"}[5m]))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Error ratio",
   "description": "",
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(mlserve_http_requests_total{namespace=\"$namespace\",route=\"/v1/predict\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(mlserve_http_requests_total{namespace=\"$namespace\",route=\"/v1/predict\"}[5m])),1e-9)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.005
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "p50",
   "description": "",
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(mlserve_http_request_duration_seconds_bucket{namespace=\"$namespace\",route=\"/v1/predict\"}[5m])))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "p95",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(mlserve_http_request_duration_seconds_bucket{namespace=\"$namespace\",route=\"/v1/predict\"}[5m])))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.3
       },
       {
        "color": "red",
        "value": 0.5
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "p99",
   "description": "",
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(mlserve_http_request_duration_seconds_bucket{namespace=\"$namespace\",route=\"/v1/predict\"}[5m])))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 7,
   "type": "gauge",
   "title": "Apdex (T=100ms)",
   "description": "Satisfied <=100ms, tolerating <=500ms (4T)",
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(mlserve_http_request_duration_seconds_bucket{namespace=\"$namespace\",route=\"/v1/predict\",le=\"0.1\"}[5m])) + sum(rate(mlserve_http_request_duration_seconds_bucket{namespace=\"$namespace\",route=\"/v1/predict\",le=\"0.5\"}[5m]))) / 2 / clamp_min(sum(rate(mlserve_http_request_duration_seconds_count{namespace=\"$namespace\",route=\"/v1/predict\"}[5m])),1e-9)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.85
       },
       {
        "color": "green",
        "value": 0.94
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showThresholdMarkers": true
   }
  },
  {
   "id": 8,
   "type": "heatmap",
   "title": "Latency distribution (heatmap)",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (le) (increase(mlserve_http_request_duration_seconds_bucket{namespace=\"$namespace\",route=\"/v1/predict\"}[$__rate_interval]))",
     "format": "heatmap",
     "legendFormat": "{{le}}"
    }
   ],
   "options": {
    "calculate": false,
    "yAxis": {
     "unit": "s"
    },
    "color": {
     "scheme": "Oranges",
     "mode": "scheme"
    },
    "cellGap": 1
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Latency percentiles",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(mlserve_http_request_duration_seconds_bucket{namespace=\"$namespace\",route=\"/v1/predict\"}[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.9, sum by (le) (rate(mlserve_http_request_duration_seconds_bucket{namespace=\"$namespace\",route=\"/v1/predict\"}[5m])))",
     "legendFormat": "p90"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(mlserve_http_request_duration_seconds_bucket{namespace=\"$namespace\",route=\"/v1/predict\"}[5m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "D",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(mlserve_http_request_duration_seconds_bucket{namespace=\"$namespace\",route=\"/v1/predict\"}[5m])))",
     "legendFormat": "p99"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Model predict() vs end-to-end p95",
   "description": "Gap = serialization, validation, queueing",
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(mlserve_inference_duration_seconds_bucket{namespace=\"$namespace\"}[5m])))",
     "legendFormat": "model compute"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(mlserve_http_request_duration_seconds_bucket{namespace=\"$namespace\",route=\"/v1/predict\"}[5m])))",
     "legendFormat": "end-to-end"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineWidth": 1
     }
    },
