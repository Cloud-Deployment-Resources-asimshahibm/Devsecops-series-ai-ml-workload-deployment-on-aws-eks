{
 "uid": "slo-error-budget",
 "title": "ML Platform \u2014 SLO / SLI & Error Budgets",
 "description": "SLOs defined in charts/observability-rules/values.yaml. Policy: docs/OBSERVABILITY.md#error-budget-policy",
 "tags": [
  "ml",
  "slo",
  "sre"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Prometheus",
    "type": "datasource",
    "query": "prometheus",
    "current": {
     "text": "Prometheus",
     "value": "prometheus"
    },
    "hide": 0
   },
   {
    "name": "slo",
    "label": "SLO",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(slo:objective:ratio, slo)",
     "refId": "q"
    },
    "definition": "label_values(slo:objective:ratio, slo)",
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Portfolio \u2014 all SLOs",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "table",
   "title": "SLO status",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:objective:ratio",
     "format": "table",
     "instant": true,
     "legendFormat": ""
    },
    {
     "refId": "B",
     "expr": "slo:sli:ratio",
     "format": "table",
     "instant": true,
     "legendFormat": ""
    },
    {
     "refId": "C",
     "expr": "slo:error_budget_remaining:ratio",
     "format": "table",
     "instant": true,
     "legendFormat": ""
    },
    {
     "refId": "D",
     "expr": "slo:burn_rate{window=\"1h\"}",
     "format": "table",
     "instant": true,
     "legendFormat": ""
    },
    {
     "refId": "E",
     "expr": "slo:burn_rate{window=\"6h\"}",
     "format": "table",
     "instant": true,
     "legendFormat": ""
    },
    {
     "refId": "F",
     "expr": "slo:burn_rate{window=\"3d\"}",
     "format": "table",
     "instant": true,
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 3
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "Burn.*"
      },
      "properties": [
       {
        "id": "unit",
        "value": "x"
       },
       {
        "id": "decimals",
        "value": 2
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 1
          },
          {
           "color": "red",
           "value": 6
          }
         ]
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Budget remaining"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "gradient"
        }
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 1
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "orange",
           "value": 0.25
          },
          {
           "color": "green",
           "value": 0.5
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "window": true
      },
      "indexByName": {
       "slo": 0,
       "service": 1,
       "team": 2
      },
      "renameByName": {
       "Value #A": "Objective",
       "Value #B": "SLI (period)",
       "Value #C": "Budget remaining",
       "Value #D": "Burn 1h",
       "Value #E": "Burn 6h",
       "Value #F": "Burn 3d"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Budget remaining"
       }
      ]
     }
    }
   ],
   "options": {
    "showHeader": true
   }
  },
  {
   "id": 3,
   "type": "row",
   "title": "SLO: $slo",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "repeat": "slo"
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Objective",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 4,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:objective:ratio{slo=~\"$slo\"}",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "SLI over period",
   "description": "",
   "gridPos": {
    "x": 4,
    "y": 10,
    "w": 4,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:sli:ratio{slo=~\"$slo\"}",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 3
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 6,
   "type": "gauge",
   "title": "Error budget remaining",
   "description": "",
   "gridPos": {
    "x": 8,
    "y": 10,
    "w": 5,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:error_budget_remaining:ratio{slo=~\"$slo\"}",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showThresholdMarkers": true
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "Budget in minutes left",
   "description": "Remaining 'bad minutes' at 100% error rate before the SLO is breached.",
   "gridPos": {
    "x": 13,
    "y": 10,
    "w": 5,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:error_budget_remaining:ratio{slo=~\"$slo\"} * on (slo) slo:error_budget:ratio{slo=~\"$slo\"} * on (slo) slo:period_days{slo=~\"$slo\"} * 24 * 60",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "m",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 8,
   "type": "stat",
   "title": "Current burn rate (1h)",
   "description": "",
   "gridPos": {
    "x": 18,
    "y": 10,
    "w": 6,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:burn_rate{slo=~\"$slo\",window=\"1h\"}",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "x",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 14.4
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Burn rate by window",
   "description": "Multi-window multi-burn-rate: page when BOTH long and short windows exceed the factor.",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:burn_rate{slo=~\"$slo\",window=\"5m\"}",
     "legendFormat": "5m"
    },
    {
     "refId": "B",
     "expr": "slo:burn_rate{slo=~\"$slo\",window=\"1h\"}",
     "legendFormat": "1h"
    },
    {
     "refId": "C",
     "expr": "slo:burn_rate{slo=~\"$slo\",window=\"6h\"}",
     "legendFormat": "6h"
    },
    {
     "refId": "D",
     "expr": "slo:burn_rate{slo=~\"$slo\",window=\"1d\"}",
     "legendFormat": "1d"
    },
    {
     "refId": "E",
     "expr": "slo:burn_rate{slo=~\"$slo\",window=\"3d\"}",
     "legendFormat": "3d"
    },
    {
     "refId": "F",
     "expr": "vector(1)",
     "legendFormat": "1x = budget exactly consumed"
    },
    {
     "refId": "G",
     "expr": "vector(6)",
     "legendFormat": "6x slow page"
    },
    {
     "refId": "H",
     "expr": "vector(14.4)",
     "legendFormat": "14.4x fast page"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "x",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Error budget remaining (trend)",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:error_budget_remaining:ratio{slo=~\"$slo\"}",
     "legendFormat": "{{slo}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "max": 1,
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "SLI error ratio",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:sli_error:ratio_rate{slo=~\"$slo\",window=\"5m\"}",
     "legendFormat": "5m"
    },
    {
     "refId": "B",
     "expr": "slo:sli_error:ratio_rate{slo=~\"$slo\",window=\"1h\"}",
     "legendFormat": "1h"
    },
    {
     "refId": "C",
     "expr": "slo:error_budget:ratio{slo=~\"$slo\"}",
     "legendFormat": "allowed (1 - objective)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "line",
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Budget consumed per day",
   "description": "Fraction of the whole period budget consumed by the last 24h. Sustainable pace = 1 / period_days.",
   "gridPos": {
    "x": 12,
    "y": 25,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "slo:sli_error:ratio_rate{slo=~\"$slo\",window=\"1d\"} / on (slo) group_left () slo:error_budget:ratio{slo=~\"$slo\"} / on (slo) group_left () slo:period_days{slo=~\"$slo\"}",
     "legendFormat": "{{slo}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      },
      "drawStyle": "bars",
      "lineWidth": 1
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 13,
   "type": "alertlist",
   "title": "Firing SLO alerts",
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 24,
    "h": 6
   },
   "options": {
    "alertName": "SLOErrorBudget",
    "stateFilter": {
     "firing": true,
     "pending": true
    },
    "maxItems": 20,
    "sortOrder": 1,
    "groupMode": "default"
   }
  }
 ],
 "editable": true,
 "graphTooltip": 1,
 "links": [
  {
   "title": "ML Platform dashboards",
   "type": "dashboards",
   "tags": [
    "ml"
   ],
   "asDropdown": true
  }
 ]
}